{
  "name": "trashbot",
  "display_name": "TrashBot (self-driving kitchen can)",
  "task": "A kitchen trash can on wheels that seals the full bag, drives it to the landfill cart in the garage, tips it in, puts in a fresh bag from its own cartridge and returns to charge.",
  "trigger": {
    "type": "phone_button",
    "label": "Take out the trash",
    "options": [],
    "notify_on": [
      "done",
      "blocked",
      "needs_help"
    ]
  },
